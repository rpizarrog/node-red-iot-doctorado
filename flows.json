    {
        "id": "2ab0fc77734d4677",
        "type": "function",
        "z": "13255e4cfce14d66",
        "name": "Procesar datos IoT",
        "func": "let datos = msg.payload;\n\n\n// ---------------------------------------------------------\n// TEMPERATURA\n// ---------------------------------------------------------\n\nlet msgTemperatura = {\n\n    topic: \"Temperatura\",\n\n    payload: datos.temperatura\n\n};\n\n\n// ---------------------------------------------------------\n// HUMEDAD\n// ---------------------------------------------------------\n\nlet msgHumedad = {\n\n    topic: \"Humedad\",\n\n    payload: datos.humedad\n\n};\n\n\n// ---------------------------------------------------------\n// DISTANCIA\n// ---------------------------------------------------------\n\nlet msgDistancia = {\n\n    topic: \"Distancia\",\n\n    payload: datos.distancia\n\n};\n\n\n// ---------------------------------------------------------\n// LUMINOSIDAD\n// ---------------------------------------------------------\n\nlet msgLuminosidad = {\n\n    topic: \"Luminosidad\",\n\n    payload: datos.luminosidad\n\n};\n\n\n// ---------------------------------------------------------\n// MOVIMIENTO\n// ---------------------------------------------------------\n\nlet msgMovimiento = {\n\n    payload: datos.movimiento === 1\n        ? \"Movimiento detectado\"\n        : \"Sin movimiento\",\n\n    topic: \"Movimiento\"\n\n};\n\n\n// ---------------------------------------------------------\n// CLASIFICACIÓN\n// ---------------------------------------------------------\n\nlet msgClasificacion = {\n\n    topic: \"Clasificacion\",\n\n    payload: datos.clasificacion\n\n};\n\n\n// ---------------------------------------------------------\n// ALARMA\n// ---------------------------------------------------------\n\nlet msgAlarma = {\n\n    topic: \"Alarma\",\n\n    payload: datos.alarma\n\n};\n\n\n// ---------------------------------------------------------\n// SALIDAS\n// ---------------------------------------------------------\n\nreturn [\n\n    msgTemperatura,\n    msgHumedad,\n    msgDistancia,\n    msgLuminosidad,\n    msgMovimiento,\n    msgClasificacion,\n    msgAlarma\n\n];",
