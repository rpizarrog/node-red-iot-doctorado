        "format": "<template>\n\n    <div\n        class=\"evaluacion\"\n        :class=\"{\n            normal: msg.payload == 'Normal',\n            movimiento: msg.payload == 'Movimiento cercano' ||\n                        msg.payload == 'Movimiento lejano',\n            precaucion: msg.payload == 'Posible intrusion' ||\n                        msg.payload == 'Posible anomalia',\n            peligro: msg.payload == 'Intruso'\n        }\"\n    >\n\n        <div class=\"titulo\">\n            Evaluación del sistema inteligente\n        </div>\n\n        <div class=\"resultado\">\n            {{ msg.payload }}\n        </div>\n\n    </div>\n\n</template>\n\n\n<style>\n\n.evaluacion {\n    width: 100%;\n    padding: 20px;\n    text-align: center;\n    border-radius: 18px;\n    box-sizing: border-box;\n    border: 3px solid;\n    transition: all 0.4s ease;\n}\n\n/* NORMAL */\n.normal {\n    background-color: #e8f5e9;\n    border-color: #2e7d32;\n}\n\n/* MOVIMIENTO */\n.movimiento {\n    background-color: #e3f2fd;\n    border-color: #1976d2;\n}\n\n/* PRECAUCIÓN */\n.precaucion {\n    background-color: #fff3e0;\n    border-color: #ef6c00;\n}\n\n/* PELIGRO */\n.peligro {\n    background-color: #ffebee;\n    border-color: #c62828;\n}\n\n.titulo {\n    font-size: 24px;\n    font-weight: bold;\n    margin-bottom: 18px;\n}\n\n.resultado {\n    font-size: 30px;\n    font-weight: bold;\n}\n\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
