        "id": "b03f229af866e171",
        "type": "function",
        "z": "13255e4cfce14d66",
        "name": "Detectar inicio de evento",
        "func": "// Obtener el estado actual del sensor PIR\nlet actual = Number(msg.payload.movimiento);\n\n// Recuperar el estado anterior almacenado\nlet anterior = context.get(\"movimientoAnterior\") || 0;\n\n// Guardar el estado actual para la siguiente lectura\ncontext.set(\"movimientoAnterior\", actual);\n\n// Detectar solamente la transición 0 → 1\nif (anterior === 0 && actual === 1) {\n    return msg;\n}\n\n// En cualquier otro caso no enviar mensaje\nreturn null;",
