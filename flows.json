        "format": "<div style=\"\n    background:#eaf4ff;\n    border:3px solid #1976d2;\n    border-radius:18px;\n    padding:20px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:40px;\n\">\n\n    <!-- COLUMNA IZQUIERDA -->\n    <div style=\"\n        flex:1;\n        text-align:center;\n    \">\n\n        <h2>📷 VISIÓN ARTIFICIAL</h2>\n\n        <div>\n            Imagen:\n            <b>{{ msg.payload.imagen }}</b>\n        </div>\n\n        <p>Objeto detectado</p>\n\n        <div style=\"\n            font-size:32px;\n            font-weight:bold;\n        \">\n            {{ msg.payload.objeto.toUpperCase() }}\n        </div>\n\n        <p>\n            Confianza:\n            <b>{{ Number(msg.payload.confianza).toFixed(2) }} %</b>\n        </p>\n\n    </div>\n\n\n    <!-- COLUMNA DERECHA -->\n    <div style=\"\n        flex:1;\n        text-align:center;\n    \">\n\n        <img\n            :src=\"'data:image/jpeg;base64,' + msg.payload.imagen_base64\"\n            style=\"\n                max-width:400px;\n                max-height:300px;\n                width:auto;\n                height:auto;\n                object-fit:contain;\n                border-radius:12px;\n            \"\n        >\n\n    </div>\n\n</div>",
