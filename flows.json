    {
        "id": "96d5c6dba41ea11d",
        "type": "function",
        "z": "13255e4cfce14d66",
        "name": "Procesar Visión",
        "func": "// Recibir datos publicados por Python + YOLO\nlet datos = msg.payload;\n\n// Por seguridad, si llega como texto JSON\nif (typeof datos === \"string\") {\n    datos = JSON.parse(datos);\n}\n\n// Verificar que existan detecciones\nif (\n    !datos.detecciones ||\n    datos.detecciones.length === 0\n) {\n    msg.payload = {\n        imagen: datos.imagen || \"Sin imagen\",\n        objeto: \"No detectado\",\n        confianza: 0\n    };\n\n    return msg;\n}\n\n// Tomar la detección con mayor confianza\nlet principal = datos.detecciones.reduce(\n    (mayor, actual) =>\n        actual.confianza > mayor.confianza\n            ? actual\n            : mayor\n);\n\n// Preparar información para el Dashboard\nmsg.payload = {\n    imagen: datos.imagen,\n    imagen_base64: datos.imagen_base64,\n    objeto: principal.objeto,\n    confianza: principal.confianza * 100,\n    detecciones: datos.detecciones\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 460,
        "wires": [
            [
                "00be0f05f30528bd",
                "76ac7a7790d4569a",
                "e105cf26fbf70b82"
            ]
        ]
    },
    {
        "id": "e105cf26fbf70b82",
        "type": "function",
        "z": "13255e4cfce14d66",
        "name": "Combinar IoT + Visión",
        "func": "// ======================================================\n// COMBINAR IoT + VISIÓN ARTIFICIAL\n// ======================================================\n\nlet datos = msg.payload;\n\n\n// ======================================================\n// 1. ¿ES UN MENSAJE IoT?\n// Lo identificamos porque contiene temperatura,\n// humedad, distancia, movimiento, etc.\n// ======================================================\n\nif (\n    datos.temperatura !== undefined &&\n    datos.movimiento !== undefined\n) {\n\n    // Guardar temporalmente último estado IoT\n    flow.set(\"ultimo_iot\", datos);\n\n    return null;\n}\n\n\n// ======================================================\n// 2. ¿ES UN MENSAJE DE VISIÓN?\n// Lo identificamos porque contiene imagen y detecciones\n// ======================================================\n\nif (\n    datos.imagen !== undefined &&\n    datos.detecciones !== undefined\n) {\n\n    // Guardar resultado de visión\n    flow.set(\"ultima_vision\", datos);\n\n\n    // Recuperar último mensaje IoT\n    let iot = flow.get(\"ultimo_iot\");\n\n\n    // Si todavía no existe IoT, esperamos\n    if (!iot) {\n        return null;\n    }\n\n\n    // ==================================================\n    // 3. CONSTRUIR JSON COMBINADO\n    // ==================================================\n\n    msg.payload = {\n\n        fecha_hora: new Date().toLocaleString(\"es-MX\"),\n\n        // -------- SENSORES --------\n\n        temperatura: iot.temperatura,\n        humedad: iot.humedad,\n        distancia: iot.distancia,\n        luminosidad: iot.luminosidad,\n        movimiento: iot.movimiento,\n\n\n        // -------- LÓGICA DIFUSA --------\n\n        muy_cerca: iot.muy_cerca,\n        cerca: iot.cerca,\n        lejos: iot.lejos,\n\n        oscuro: iot.oscuro,\n        tenue: iot.tenue,\n        brillante: iot.brillante,\n\n        clasificacion: iot.clasificacion,\n        alarma: iot.alarma,\n\n\n        // -------- VISIÓN ARTIFICIAL --------\n\n        imagen: datos.imagen,\n\n        objeto_detectado: datos.objeto,\n\n        confianza_vision: datos.confianza,\n\n        detecciones: datos.detecciones\n    };\n\n\n    // Nuevo tópico interno\n    msg.topic = \"evento_combinado\";\n\n\n    // ==================================================\n    // 4. ENVIAR JSON COMBINADO\n    // ==================================================\n\n    return msg;\n}\n\n\n// Mensaje desconocido\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 420,
        "wires": [
