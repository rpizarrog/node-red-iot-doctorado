    {
        "id": "1e7d24044cc5a02c",
        "type": "function",
        "z": "13255e4cfce14d66",
        "name": "Preparar registro CSV",
        "func": "let datos = msg.payload;\n\n// Si el mensaje llega como texto JSON, convertirlo a objeto\nif (typeof datos === \"string\") {\n\n    datos = JSON.parse(datos);\n\n}\n\n// Construir el registro que posteriormente irá al CSV\nmsg.payload = {\n\n    fecha_hora: new Date().toLocaleString(\"es-MX\"),\n\n    temperatura: datos.temperatura,\n\n    humedad: datos.humedad,\n\n    distancia: datos.distancia,\n\n    luminosidad: datos.luminosidad,\n\n    movimiento: datos.movimiento,\n\n    muy_cerca: datos.muy_cerca,\n\n    cerca: datos.cerca,\n\n    lejos: datos.lejos,\n\n    oscuro: datos.oscuro,\n\n    tenue: datos.tenue,\n\n    brillante: datos.brillante,\n\n    clasificacion: datos.clasificacion,\n\n    alarma: datos.alarma\n\n};\n\nreturn msg;",
